-- Initialize slider positions
local function updateSliders()
	local color = myESP.color
	SliderR.Size = UDim2.new(color.R, 0, 1, 0)
	SliderG.Size = UDim2.new(color.G, 0, 1, 0)
	SliderB.Size = UDim2.new(color.B, 0, 1, 0)
end
updateSliders()

-- Update sliders when rainbow is toggled
local function onRainbowToggled()
	if myESP.rainbow then
		SliderR.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		SliderG.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		SliderB.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	else
		SliderR.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
		SliderG.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
		SliderB.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
		updateSliders()
	end
end
RainbowButton.MouseButton1Click:Connect(onRainbowToggled)
