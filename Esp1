-- ModuleScript

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Connections = {
	{"Head", "UpperTorso"},
	{"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"},
	{"UpperTorso", "RightUpperArm"},
	{"LeftUpperArm", "LeftLowerArm"},
	{"RightUpperArm", "RightLowerArm"},
	{"LeftLowerArm", "LeftHand"},
	{"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"},
	{"LowerTorso", "RightUpperLeg"},
	{"LeftUpperLeg", "LeftLowerLeg"},
	{"RightUpperLeg", "RightLowerLeg"},
	{"LeftLowerLeg", "LeftFoot"},
	{"RightLowerLeg", "RightFoot"},
}

local ESP = {}
ESP.__index = ESP

function ESP.new(config)
	config = config or {}
	local self = setmetatable({}, ESP)

	self.enabled = config.enabled or false
	self.rainbow = config.rainbow or false
	self.color = config.color or Color3.new(0, 1, 0)
	self.defaultColor = self.color
	self.showSkeleton = config.showSkeleton ~= false
	self.showBox = config.showBox ~= false
	self.showName = config.showName ~= false
	self.hue = 0
	self.drawings = {}

	-- ScreenGui for names
	self.screenGui = Instance.new("ScreenGui")
	self.screenGui.Name = "ESPGui"
	self.screenGui.IgnoreGuiInset = true
	self.screenGui.ResetOnSpawn = false
	self.screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

	-- Connections
	self.playerAddedConn = Players.PlayerAdded:Connect(function(plr)
		self:AddPlayer(plr)
	end)
	self.playerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
		self:RemovePlayer(plr)
	end)

	-- Add existing players
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			self:AddPlayer(plr)
		end
	end

	-- Render loop
	self.renderConn = RunService.RenderStepped:Connect(function(dt)
		self:Update(dt)
	end)

	return self
end

function ESP:AddPlayer(plr)
	if plr == LocalPlayer then return end

	local data = {
		skeleton = {},
		box = {},
		name = nil,
		charAddedConn = nil,
	}

	-- Skeleton lines
	for i = 1, #Connections do
		local line = Drawing.new("Line")
		line.Thickness = 2
		line.Visible = false
		data.skeleton[i] = line
	end

	-- Box lines
	local boxLines = {}
	for _, dir in ipairs({"Top", "Bottom", "Left", "Right"}) do
		local line = Drawing.new("Line")
		line.Thickness = 2
		line.Visible = false
		boxLines[dir] = line
	end
	data.box = boxLines

	-- Name TextLabel with forced fixed size
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(200, 20) -- fixed pixel size
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = plr.Name
	label.FontFace = Font.new("rbxassetid://12187365977")
	label.TextSize = 14
	label.TextScaled = false
	label.AutomaticSize = Enum.AutomaticSize.None
	label.SizeConstraint = Enum.SizeConstraint.RelativeXY
	label.Visible = false
	label.Parent = self.screenGui

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Transparency = 0
	stroke.Parent = label

	data.name = label
	data.charAddedConn = plr.CharacterAdded:Connect(function() end)

	self.drawings[plr] = data
end

function ESP:RemovePlayer(plr)
	local data = self.drawings[plr]
	if data then
		for _, line in ipairs(data.skeleton) do line:Remove() end
		for _, line in pairs(data.box) do line:Remove() end
		if data.name then data.name:Destroy() end
		if data.charAddedConn then data.charAddedConn:Disconnect() end
		self.drawings[plr] = nil
	end
end

function ESP:Update(dt)
	if not self.enabled then return end

	local color = self.color
	if self.rainbow then
		self.hue = (self.hue + dt * 0.2) % 1
		color = Color3.fromHSV(self.hue, 1, 1)
	end

	local cam = workspace.CurrentCamera

	for plr, data in pairs(self.drawings) do
		local char = plr.Character
		local hum = char and char:FindFirstChild("Humanoid")
		if char and char:FindFirstChild("HumanoidRootPart") and hum and hum.Health > 0 then

			-- Name
			if self.showName and data.name then
				local head = char:FindFirstChild("Head")
				if head then
					local offsetPos = head.Position + Vector3.new(0, head.Size.Y / 2 + 1, 0)
					local pos, vis = cam:WorldToViewportPoint(offsetPos)
					if vis and pos.Z > 0 then
						data.name.Position = UDim2.fromOffset(pos.X - 100, pos.Y - 10)
						data.name.TextColor3 = color
						data.name.Visible = true
						-- debug: ensure Roblox is not changing TextSize
						if data.name.TextSize ~= 14 then
							print("Warning: TextSize changed by Roblox:", data.name.TextSize)
							data.name.TextSize = 14
						end
					else
						data.name.Visible = false
					end
				else
					data.name.Visible = false
				end
			else
				if data.name then data.name.Visible = false end
			end

		else
			for _, line in ipairs(data.skeleton) do line.Visible = false end
			for _, l in pairs(data.box) do l.Visible = false end
			if data.name then data.name.Visible = false end
		end
	end
end

function ESP:Toggle()
	self.enabled = not self.enabled
	if not self.enabled then
		for _, data in pairs(self.drawings) do
			for _, line in ipairs(data.skeleton) do line.Visible = false end
			for _, l in pairs(data.box) do l.Visible = false end
			if data.name then data.name.Visible = false end
		end
	end
end

function ESP:SetColor(newColor)
	self.color = newColor
	self.defaultColor = newColor
end

function ESP:ToggleRainbow()
	self.rainbow = not self.rainbow
	if not self.rainbow then
		self.color = self.defaultColor
	end
end

function ESP:IncludeSkeleton() self.showSkeleton = true end
function ESP:ExcludeSkeleton() self.showSkeleton = false end
function ESP:IncludeBox() self.showBox = true end
function ESP:ExcludeBox() self.showBox = false end
function ESP:IncludeNames() self.showName = true end
function ESP:ExcludeNames() self.showName = false end

function ESP:Destroy()
	if self.renderConn then self.renderConn:Disconnect() end
	if self.playerAddedConn then self.playerAddedConn:Disconnect() end
	if self.playerRemovingConn then self.playerRemovingConn:Disconnect() end
	for plr in pairs(self.drawings) do self:RemovePlayer(plr) end
	if self.screenGui then self.screenGui:Destroy() end
end

return ESP
