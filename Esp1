-- ModuleScript (e.g., place in ReplicatedStorage or ServerScriptService, but since Local, probably StarterPlayerScripts as Local Module)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Connections = {
	{"Head", "UpperTorso"},
	{"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"},
	{"UpperTorso", "RightUpperArm"},
	{"LeftUpperArm", "LeftLowerArm"},
	{"RightUpperArm", "RightLowerArm"},
	{"LeftLowerArm", "LeftHand"},
	{"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"},
	{"LowerTorso", "RightUpperLeg"},
	{"LeftUpperLeg", "LeftLowerLeg"},
	{"RightUpperLeg", "RightLowerLeg"},
	{"LeftLowerLeg", "LeftFoot"},
	{"RightLowerLeg", "RightFoot"},
}

local ESP = {}
ESP.__index = ESP

function ESP.new(config)
	config = config or {}
	local self = setmetatable({}, ESP)
	
	self.enabled = config.enabled or false
	self.rainbow = config.rainbow or false
	self.color = config.color or Color3.new(0, 1, 0)
	self.defaultColor = self.color
	self.showSkeleton = config.showSkeleton ~= false
	self.showBox = config.showBox ~= false
	self.showName = config.showName ~= false
	self.hue = 0
	self.drawings = {}
	
	-- ScreenGui for names
	self.screenGui = Instance.new("ScreenGui")
	self.screenGui.Name = "ESPGui"
	self.screenGui.ResetOnSpawn = false
	self.screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	
	-- Connections
	self.playerAddedConn = Players.PlayerAdded:Connect(function(plr)
		self:AddPlayer(plr)
	end)
	self.playerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
		self:RemovePlayer(plr)
	end)
	
	-- Add existing players
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			self:AddPlayer(plr)
		end
	end
	
	-- Render loop
	self.renderConn = RunService.RenderStepped:Connect(function(dt)
		self:Update(dt)
	end)
	
	return self
end

function ESP:AddPlayer(plr)
	if plr == LocalPlayer then return end
	
	local data = {
		skeleton = {},
		box = {},
		name = nil,
		charAddedConn = nil,
	}
	
	-- Skeleton lines
	for i = 1, #Connections do
		local line = Drawing.new("Line")
		line.Thickness = 2
		line.Visible = false
		data.skeleton[i] = line
	end
	
	-- Box lines
	local boxLines = {}
	for _, dir in ipairs({"Top", "Bottom", "Left", "Right"}) do
		local line = Drawing.new("Line")
		line.Thickness = 2
		line.Visible = false
		boxLines[dir] = line
	end
	data.box = boxLines
	
	-- Name TextLabel with custom font and stroke
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 200, 0, 20)  -- Fixed pixel size, centered dynamically
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)  -- White text by default, can change with color
	label.Text = plr.Name
	label.FontFace = Font.new("rbxassetid://12187365977")  -- Rubik font
	label.TextSize = 14
	label.TextWrapped = false
	label.Visible = false
	label.Parent = self.screenGui
	
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3  -- Thick black stroke
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Transparency = 0
	stroke.Parent = label
	
	data.name = label
	
	-- Handle character respawn (no need for extra logic, update checks char)
	data.charAddedConn = plr.CharacterAdded:Connect(function() end)  -- Placeholder to disconnect later
	
	self.drawings[plr] = data
end

function ESP:RemovePlayer(plr)
	local data = self.drawings[plr]
	if data then
		for _, line in ipairs(data.skeleton) do
			line:Remove()
		end
		for _, line in pairs(data.box) do
			line:Remove()
		end
		if data.name then
			data.name:Destroy()
		end
		if data.charAddedConn then
			data.charAddedConn:Disconnect()
		end
		self.drawings[plr] = nil
	end
end

function ESP:Update(dt)
	if not self.enabled then return end
	
	local color = self.color
	if self.rainbow then
		self.hue = (self.hue + dt * 0.2) % 1
		color = Color3.fromHSV(self.hue, 1, 1)
	end
	
	local cam = workspace.CurrentCamera
	
	for plr, data in pairs(self.drawings) do
		local char = plr.Character
		local hum = char and char:FindFirstChild("Humanoid")
		if char and char:FindFirstChild("HumanoidRootPart") and hum and hum.Health > 0 then
			-- Skeleton
			if self.showSkeleton then
				for i, pair in ipairs(Connections) do
					local part0 = char:FindFirstChild(pair[1])
					local part1 = char:FindFirstChild(pair[2])
					local line = data.skeleton[i]
					if part0 and part1 then
						local pos0, vis0 = cam:WorldToViewportPoint(part0.Position)
						local pos1, vis1 = cam:WorldToViewportPoint(part1.Position)
						if vis0 and vis1 and pos0.Z > 0 and pos1.Z > 0 then
							line.From = Vector2.new(pos0.X, pos0.Y)
							line.To = Vector2.new(pos1.X, pos1.Y)
							line.Color = color
							line.Visible = true
						else
							line.Visible = false
						end
					else
						line.Visible = false
					end
				end
			else
				for _, line in ipairs(data.skeleton) do
					line.Visible = false
				end
			end
			
			-- Bounding Box
			if self.showBox then
				local points = {}
				for _, part in ipairs(char:GetChildren()) do
					if part:IsA("BasePart") then
						local cf = part.CFrame
						local halfSize = part.Size / 2
						for x = -1, 1, 2 do
							for y = -1, 1, 2 do
								for z = -1, 1, 2 do
									local corner = cf * Vector3.new(x * halfSize.X, y * halfSize.Y, z * halfSize.Z)
									local screen, vis = cam:WorldToViewportPoint(corner)
									if vis and screen.Z > 0 then
										table.insert(points, Vector2.new(screen.X, screen.Y))
									end
								end
							end
						end
					end
				end
				
				if #points > 0 then
					local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
					for _, p in ipairs(points) do
						minX = math.min(minX, p.X)
						maxX = math.max(maxX, p.X)
						minY = math.min(minY, p.Y)
						maxY = math.max(maxY, p.Y)
					end
					
					local bb = data.box
					bb.Top.From = Vector2.new(minX, minY)
					bb.Top.To = Vector2.new(maxX, minY)
					bb.Bottom.From = Vector2.new(minX, maxY)
					bb.Bottom.To = Vector2.new(maxX, maxY)
					bb.Left.From = Vector2.new(minX, minY)
					bb.Left.To = Vector2.new(minX, maxY)
					bb.Right.From = Vector2.new(maxX, minY)
					bb.Right.To = Vector2.new(maxX, maxY)
					
					for _, l in pairs(bb) do
						l.Color = color
						l.Visible = true
					end
				else
					for _, l in pairs(data.box) do
						l.Visible = false
					end
				end
			else
				for _, l in pairs(data.box) do
					l.Visible = false
				end
			end
			
			-- Name
			if self.showName then
				local head = char:FindFirstChild("Head")
				if head then
					local offsetPos = head.Position + Vector3.new(0, head.Size.Y / 2 + 1, 0)  -- Slightly above head
					local pos, vis = cam:WorldToViewportPoint(offsetPos)
					if vis and pos.Z > 0 then
						-- Center the label
						data.name.Position = UDim2.new(0, pos.X - 100, 0, pos.Y - 10)  -- Offset half size (200/2=100, 20/2=10)
						data.name.TextColor3 = color  -- Use ESP color for text
						data.name.Visible = true
					else
						data.name.Visible = false
					end
				else
					data.name.Visible = false
				end
			else
				data.name.Visible = false
			end
		else
			-- Hide everything if no char or dead
			for _, line in ipairs(data.skeleton) do line.Visible = false end
			for _, l in pairs(data.box) do l.Visible = false end
			data.name.Visible = false
		end
	end
end

function ESP:Toggle()
	self.enabled = not self.enabled
	if not self.enabled then
		for _, data in pairs(self.drawings) do
			for _, line in ipairs(data.skeleton) do line.Visible = false end
			for _, l in pairs(data.box) do l.Visible = false end
			data.name.Visible = false
		end
	end
end

function ESP:SetColor(newColor)
	self.color = newColor
	self.defaultColor = newColor  -- Update default if changed
end

function ESP:ToggleRainbow()
	self.rainbow = not self.rainbow
	if not self.rainbow then
		self.color = self.defaultColor
	end
end

function ESP:IncludeSkeleton()
	self.showSkeleton = true
end

function ESP:ExcludeSkeleton()
	self.showSkeleton = false
end

function ESP:IncludeBox()
	self.showBox = true
end

function ESP:ExcludeBox()
	self.showBox = false
end

function ESP:IncludeNames()
	self.showName = true
end

function ESP:ExcludeNames()
	self.showName = false
end

function ESP:Destroy()
	if self.renderConn then self.renderConn:Disconnect() end
	if self.playerAddedConn then self.playerAddedConn:Disconnect() end
	if self.playerRemovingConn then self.playerRemovingConn:Disconnect() end
	for plr in pairs(self.drawings) do
		self:RemovePlayer(plr)
	end
	if self.screenGui then self.screenGui:Destroy() end
end

return ESP
